{
  "name": "padock",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "dotenv -e .env -- pnpm --filter @padock/db generate",
    "db:migrate:dev": "dotenv -e .env -- pnpm --filter @padock/db migrate:dev",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @padock/db migrate:deploy",
    "db:migrate:status": "dotenv -e .env -- pnpm --filter @padock/db migrate:status",
    "db:studio": "dotenv -e .env -- pnpm --filter @padock/db studio",
    "auth:generate": "dotenv -e .env -- pnpm --filter @padock/auth exec auth generate --config ./src/index.ts --output ../db/prisma/schema.prisma -y",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
