// Padock database schema.
// Better Auth's own models (user/session/account/verification/apikey/
// organization/member/invitation) are appended below this line by
// `npx auth@latest generate`, run against packages/auth's config — see
// package.json's `generate` script. Padock's own models (starting with
// Project) are added by hand below the Better Auth block.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String            @id
  name                    String
  email                   String
  emailVerified           Boolean           @default(false)
  image                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  sessions                Session[]
  accounts                Account[]
  members                 Member[]
  invitations             Invitation[]
  createdTasks            Task[]
  createdDocs             Doc[]
  createdChannels         Channel[]
  sentMessages            ChatMessage[]     @relation("ChatMessageSender")
  receivedMessages        ChatMessage[]     @relation("ChatMessageRecipient")
  ownedApprovalRequests   ApprovalRequest[] @relation("ApprovalRequestOwner")
  decidedApprovalRequests ApprovalRequest[] @relation("ApprovalRequestDecider")
  createdProjects         Project[]
  projectMemberships      ProjectMember[]
  auditLogs               AuditLog[]
  notifications           Notification[]    @relation("NotificationRecipient")
  triggeredNotifications  Notification[]    @relation("NotificationActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// --- Padock's own models (not generated by `auth generate`) ---
// Cross-domain anchor per CONTEXT.md §5.1.2: tasks and docs (Phase 1)
// will require a projectId; chat messages will tag it optionally.
model Project {
  id                      String                   @id @default(cuid())
  organizationId          String
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                    String
  createdById             String?
  createdBy               User?                    @relation(fields: [createdById], references: [id])
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  members                 ProjectMember[]
  tasks                   Task[]
  taskStates              TaskState[]
  labels                  Label[]
  docs                    Doc[]
  chatMessages            ChatMessage[]
  channels                Channel[]
  docAttributeDefinitions DocAttributeDefinition[]
  notifications           Notification[]

  @@index([organizationId])
  @@map("project")
}

// Access control layer for Projects: only a project's ProjectMembers can
// see or act on it (enforced in the API layer, not here — this migration
// only adds the schema + backfills existing data so nothing gets locked
// out; per-router membership checks are a separate, deferred pass).
// `role` is independent of the org-level `Member.role` (Better Auth's
// Organization plugin) — being an org admin does not imply project admin.
enum ProjectMemberRole {
  admin
  member
}

model ProjectMember {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            ProjectMemberRole @default(member)
  createdAt       DateTime          @default(now())
  taskAssignments TaskAssignee[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_member")
}

// Plane-style configurable workflow (CONTEXT.md §5.1.5): each project
// defines its own set of states instead of sharing one global enum.
// `group` is the cross-project semantic category (for reporting/search
// even when names differ), `position` orders them in that project's
// workflow, `isDefault` is the state new tasks land in when unset.
enum TaskStateGroup {
  backlog
  unstarted
  started
  completed
  cancelled
}

model TaskState {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  group     TaskStateGroup
  position  Int
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  tasks     Task[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("task_state")
}

// Plane's own five-level scheme (`none` is an explicit "no priority set",
// not the same as an unset/null column — keeps Board/Table grouping simple).
enum TaskPriority {
  urgent
  high
  medium
  low
  none
}

model Task {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  stateId       String
  state         TaskState      @relation(fields: [stateId], references: [id])
  priority      TaskPriority   @default(none)
  startDate     DateTime?
  endDate       DateTime?
  assignees     TaskAssignee[]
  labels        TaskLabel[]
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@index([projectId])
  @@index([stateId])
  @@index([projectId, startDate])
  @@index([projectId, endDate])
  @@map("task")
}

// Plane-style project-scoped tag (CONTEXT.md §5.1's Label gap): a flat
// name+color, no hierarchy — same "configurable set per project" shape as
// TaskState, but without a group/position/isDefault since labels aren't a
// workflow. `color` is a hex string the web UI renders as a dot/badge
// background; the CLI/MCP just pass it through opaquely.
model Label {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime    @default(now())
  tasks     TaskLabel[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("label")
}

// Join table, same shape/precedent as TaskAssignee — "label must belong to
// the task's own project" is an API-layer invariant, not a schema one.
model TaskLabel {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_label")
}

// An assignee is a ProjectMember, not a bare User — being assignable to a
// task requires having been added to that project first (§ProjectMember).
// Invariant "projectMember.projectId === task.projectId" is enforced in
// the API router, not the schema — same precedent as ChatMessage's
// DM-vs-channel exclusivity (Prisma has no cross-column CHECK constraint
// DSL to express it directly).
model TaskAssignee {
  id              String        @id @default(cuid())
  taskId          String
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectMemberId String
  projectMember   ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([taskId, projectMemberId])
  @@index([taskId])
  @@index([projectMemberId])
  @@map("task_assignee")
}

// Block-based storage (CONTEXT.md §5.1's doc entry) — `blocks` is a
// parsed mdast tree (Markdown AST), not a bespoke block schema: mdast
// already models a document as a tree of typed blocks (heading,
// paragraph, list, code, ...), so it doubles as the "AFFiNE-style
// blocks" storage without inventing a new format. `searchText` is a
// plain-text extraction of `blocks`, kept only so full-text search
// stays a normal Postgres text column. Neither is exposed to callers —
// packages/api/src/router/doc.ts converts `blocks` back to Markdown
// (`content`) on every read, preserving Phase 1's CLI/Skill contract.
model Doc {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  blocks          Json
  searchText      String
  createdById     String
  createdBy       User                @relation(fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  attributeValues DocAttributeValue[]

  @@index([projectId])
  @@map("doc")
}

// Custom doc attributes (CONTEXT.md §5.1.18): a project-scoped, user-defined
// property schema (Notion-style), not a fixed set of columns — every
// project starts with zero attributes. `type` is immutable after creation
// (no in-place text->number conversion); renaming/reordering stay editable.
// `order` drives manual sort in the property panel (§5.1.18's "needs manual
// sort" decision), same shape as TaskState.position.
enum DocAttributeType {
  text
  number
  select
  date
  checkbox
}

model DocAttributeDefinition {
  id        String               @id @default(cuid())
  projectId String
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  type      DocAttributeType
  order     Int
  createdAt DateTime             @default(now())
  options   DocAttributeOption[]
  values    DocAttributeValue[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("doc_attribute_definition")
}

// Choices for a `select`-type definition only — its own table rather than
// reusing Label, since overloading Label's meaning to double as generic
// select-options would blur what a "label" is (§5.1.18).
model DocAttributeOption {
  id           String                 @id @default(cuid())
  definitionId String
  definition   DocAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  name         String
  color        String
  order        Int
  values       DocAttributeValue[]

  @@index([definitionId])
  @@map("doc_attribute_option")
}

// EAV value row, one typed column per possible DocAttributeType so Postgres
// enforces real column types/FKs instead of pushing all validation into the
// API layer (§5.1.18, chosen over a single Json column on Doc). Only
// written when a value is actually set — a doc with nothing filled in for
// a given attribute simply has no row, no backfill on new definitions.
model DocAttributeValue {
  id             String                 @id @default(cuid())
  docId          String
  doc            Doc                    @relation(fields: [docId], references: [id], onDelete: Cascade)
  definitionId   String
  definition     DocAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  valueText      String?
  valueNumber    Float?
  valueDate      DateTime?
  valueBoolean   Boolean?
  selectOptionId String?
  selectOption   DocAttributeOption?    @relation(fields: [selectOptionId], references: [id], onDelete: Cascade)
  updatedAt      DateTime               @updatedAt

  @@unique([docId, definitionId])
  @@index([docId])
  @@index([definitionId])
  @@map("doc_attribute_value")
}

// Org-wide or project-scoped (projectId optional, same opt-in pattern
// as ChatMessage's own project tag below) — CONTEXT.md §5.1.2/Phase 4.
// Single-level message container per ADR-0001 (docs/adr/0001-collapse-
// topic-into-channel.md): this model absorbs what used to be the
// separate Topic entity — a Channel *is* the thing a message attaches
// to directly, there's no intermediate grouping level anymore. Must be
// created explicitly before use (never materializes implicitly from a
// message send). `isDefault` marks a project's one auto-seeded "project
// channel" (project.create, mirroring TaskState.isDefault, §5.1.5);
// any other channel on that project is a manually-created "issue
// channel" (CONTEXT.md §5.1.10). No per-channel membership model in
// v1: every org member can see every channel (§6/§7's "no granular
// permissions yet" stance).
model Channel {
  id          String        @id @default(cuid())
  title       String
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isDefault   Boolean       @default(false)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]

  @@index([projectId])
  @@map("channel")
}

// A message is either a DM (recipientId set) or a channel message
// (channelId set) — never both. Enforced in the tRPC router, not the
// schema (Prisma has no cross-column CHECK constraint DSL).
model ChatMessage {
  id            String         @id @default(cuid())
  senderId      String
  sender        User           @relation("ChatMessageSender", fields: [senderId], references: [id])
  recipientId   String?
  recipient     User?          @relation("ChatMessageRecipient", fields: [recipientId], references: [id])
  channelId     String?
  channel       Channel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  content       String
  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@index([senderId])
  @@index([recipientId])
  @@index([projectId])
  @@index([channelId])
  @@map("chat_message")
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

// Phase 6b: a queued write from an "unattended" PAT. `path` is the
// dot-joined tRPC procedure path (e.g. "task.updateState"), `input` is
// the already-zod-validated call input, stored verbatim for replay via
// appRouter.createCaller. Runs as the *key owner* (userId), reviewed by
// a different human (decidedById) — single-tenant, so any org member
// can approve, matching the no-per-resource-membership precedent
// elsewhere (channels, chat).
model ApprovalRequest {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("ApprovalRequestOwner", fields: [userId], references: [id])
  path        String
  input       Json
  status      ApprovalStatus @default(pending)
  result      Json?
  decidedById String?
  decidedBy   User?          @relation("ApprovalRequestDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([status])
  @@map("approval_request")
}

// Cross-domain audit trail (CONTEXT.md §4's "every agent action is
// attributable and logged", not implemented until now). Written by a
// single tRPC middleware shared by every write-scoped procedure
// (`scopedProcedure`'s "write" branch, plus the session-only writes
// that bypass it — apikey.create, approval.approve/reject) instead of
// per-resolver call sites, so no new domain/procedure can forget to
// log itself. `path`/`input` mirror ApprovalRequest's own storage
// shape on purpose (same "replay-able raw call" idea, different
// purpose — trail, not queue). `queued` is set from `ctx.unattended`
// at call time, not inferred from the result: an unattended write is
// recorded once here when it's first requested (queued=true) and
// again when a human's approval replays it for real (queued=false) —
// two distinct events with two distinct timestamps, not a duplicate.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  authMethod String
  path       String
  input      Json
  queued     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([path])
  @@index([createdAt])
  @@map("audit_log")
}

// Cross-domain notification system (CONTEXT.md §5.1.19, ADR-0002).
// Recipient is always a User, never a PAT/agent identity — an agent
// acts on a User's behalf and already has its own pull mechanism
// (padock approvals status/list), it isn't an addressable inbox
// owner. `actorId` (who triggered it) is a separate axis from
// `userId` (who receives it).
enum NotificationType {
  task_assigned
  project_member_added
  chat_dm
}

// Nullable FK per trigger type, not a generic entityType/entityId —
// same DocAttributeValue precedent (§5.1.18): real Postgres FKs +
// cascade delete instead of a polymorphic reference validated only in
// the API layer. Cost: every future trigger type needs its own new
// nullable FK column and a migration (accepted, matches this
// project's prisma-migrate-first workflow, §5.1.6).
model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  taskId        String?
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chatMessageId String?
  chatMessage   ChatMessage?     @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?            @relation("NotificationActor", fields: [actorId], references: [id])
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notification")
}
