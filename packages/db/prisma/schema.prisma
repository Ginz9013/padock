// Padock database schema.
// Better Auth's own models (user/session/account/verification/apikey/
// organization/member/invitation) are appended below this line by
// `npx auth@latest generate`, run against packages/auth's config — see
// package.json's `generate` script. Padock's own models (starting with
// Project) are added by hand below the Better Auth block.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  createdTasks     Task[]
  createdDocs      Doc[]
  createdChannels  Channel[]
  sentMessages     ChatMessage[] @relation("ChatMessageSender")
  receivedMessages ChatMessage[] @relation("ChatMessageRecipient")
  ownedApprovalRequests   ApprovalRequest[] @relation("ApprovalRequestOwner")
  decidedApprovalRequests ApprovalRequest[] @relation("ApprovalRequestDecider")
  createdProjects    Project[]
  projectMemberships ProjectMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// --- Padock's own models (not generated by `auth generate`) ---
// Cross-domain anchor per CONTEXT.md §5.1.2: tasks and docs (Phase 1)
// will require a projectId; chat messages will tag it optionally.
model Project {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ProjectMember[]
  tasks          Task[]
  taskStates     TaskState[]
  labels         Label[]
  docs           Doc[]
  chatMessages   ChatMessage[]
  channels       Channel[]

  @@index([organizationId])
  @@map("project")
}

// Access control layer for Projects: only a project's ProjectMembers can
// see or act on it (enforced in the API layer, not here — this migration
// only adds the schema + backfills existing data so nothing gets locked
// out; per-router membership checks are a separate, deferred pass).
// `role` is independent of the org-level `Member.role` (Better Auth's
// Organization plugin) — being an org admin does not imply project admin.
enum ProjectMemberRole {
  admin
  member
}

model ProjectMember {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            ProjectMemberRole @default(member)
  createdAt       DateTime          @default(now())
  taskAssignments TaskAssignee[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_member")
}

// Plane-style configurable workflow (CONTEXT.md §5.1.5): each project
// defines its own set of states instead of sharing one global enum.
// `group` is the cross-project semantic category (for reporting/search
// even when names differ), `position` orders them in that project's
// workflow, `isDefault` is the state new tasks land in when unset.
enum TaskStateGroup {
  backlog
  unstarted
  started
  completed
  cancelled
}

model TaskState {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  group       TaskStateGroup
  position    Int
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  tasks       Task[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("task_state")
}

// Plane's own five-level scheme (`none` is an explicit "no priority set",
// not the same as an unset/null column — keeps Board/Table grouping simple).
enum TaskPriority {
  urgent
  high
  medium
  low
  none
}

model Task {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  stateId     String
  state       TaskState      @relation(fields: [stateId], references: [id])
  priority    TaskPriority   @default(none)
  startDate   DateTime?
  endDate     DateTime?
  assignees   TaskAssignee[]
  labels      TaskLabel[]
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId])
  @@index([stateId])
  @@index([projectId, startDate])
  @@index([projectId, endDate])
  @@map("task")
}

// Plane-style project-scoped tag (CONTEXT.md §5.1's Label gap): a flat
// name+color, no hierarchy — same "configurable set per project" shape as
// TaskState, but without a group/position/isDefault since labels aren't a
// workflow. `color` is a hex string the web UI renders as a dot/badge
// background; the CLI/MCP just pass it through opaquely.
model Label {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime    @default(now())
  tasks     TaskLabel[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("label")
}

// Join table, same shape/precedent as TaskAssignee — "label must belong to
// the task's own project" is an API-layer invariant, not a schema one.
model TaskLabel {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_label")
}

// An assignee is a ProjectMember, not a bare User — being assignable to a
// task requires having been added to that project first (§ProjectMember).
// Invariant "projectMember.projectId === task.projectId" is enforced in
// the API router, not the schema — same precedent as ChatMessage's
// DM-vs-channel exclusivity (Prisma has no cross-column CHECK constraint
// DSL to express it directly).
model TaskAssignee {
  id              String        @id @default(cuid())
  taskId          String
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectMemberId String
  projectMember   ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([taskId, projectMemberId])
  @@index([taskId])
  @@index([projectMemberId])
  @@map("task_assignee")
}

// Block-based storage (CONTEXT.md §5.1's doc entry) — `blocks` is a
// parsed mdast tree (Markdown AST), not a bespoke block schema: mdast
// already models a document as a tree of typed blocks (heading,
// paragraph, list, code, ...), so it doubles as the "AFFiNE-style
// blocks" storage without inventing a new format. `searchText` is a
// plain-text extraction of `blocks`, kept only so full-text search
// stays a normal Postgres text column. Neither is exposed to callers —
// packages/api/src/router/doc.ts converts `blocks` back to Markdown
// (`content`) on every read, preserving Phase 1's CLI/Skill contract.
model Doc {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  blocks      Json
  searchText  String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@map("doc")
}

// Org-wide or project-scoped (projectId optional, same opt-in pattern
// as ChatMessage's own project tag below) — CONTEXT.md §5.1.2/Phase 4.
// Single-level message container per ADR-0001 (docs/adr/0001-collapse-
// topic-into-channel.md): this model absorbs what used to be the
// separate Topic entity — a Channel *is* the thing a message attaches
// to directly, there's no intermediate grouping level anymore. Must be
// created explicitly before use (never materializes implicitly from a
// message send). `isDefault` marks a project's one auto-seeded "project
// channel" (project.create, mirroring TaskState.isDefault, §5.1.5);
// any other channel on that project is a manually-created "issue
// channel" (CONTEXT.md §5.1.10). No per-channel membership model in
// v1: every org member can see every channel (§6/§7's "no granular
// permissions yet" stance).
model Channel {
  id          String   @id @default(cuid())
  title       String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isDefault   Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  messages    ChatMessage[]

  @@index([projectId])
  @@map("channel")
}

// A message is either a DM (recipientId set) or a channel message
// (channelId set) — never both. Enforced in the tRPC router, not the
// schema (Prisma has no cross-column CHECK constraint DSL).
model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("ChatMessageSender", fields: [senderId], references: [id])
  recipientId String?
  recipient   User?    @relation("ChatMessageRecipient", fields: [recipientId], references: [id])
  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  content     String
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([projectId])
  @@index([channelId])
  @@map("chat_message")
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

// Phase 6b: a queued write from an "unattended" PAT. `path` is the
// dot-joined tRPC procedure path (e.g. "task.updateState"), `input` is
// the already-zod-validated call input, stored verbatim for replay via
// appRouter.createCaller. Runs as the *key owner* (userId), reviewed by
// a different human (decidedById) — single-tenant, so any org member
// can approve, matching the no-per-resource-membership precedent
// elsewhere (channels, chat).
model ApprovalRequest {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("ApprovalRequestOwner", fields: [userId], references: [id])
  path        String
  input       Json
  status      ApprovalStatus @default(pending)
  result      Json?
  decidedById String?
  decidedBy   User?          @relation("ApprovalRequestDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([status])
  @@map("approval_request")
}
