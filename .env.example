# Copy to .env for local development. docker-compose.yml also reads this file.

# --- Postgres ---
POSTGRES_USER=padock
POSTGRES_PASSWORD=padock
POSTGRES_DB=padock
DATABASE_URL=postgresql://padock:padock@localhost:5432/padock?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=padock
S3_SECRET_KEY=padockpadock
S3_BUCKET=padock

# --- Better Auth ---
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=replace-with-a-real-secret
BETTER_AUTH_URL=http://localhost:3000

# --- apps/web ---
PORT=3000
# --- apps/realtime ---
REALTIME_PORT=3001
